{
    "name": "polyvault-server",
    "type": "module",
    "scripts": {
        "start": "node --env-file=.env index.js",
        "start:local": "node index.local.js",
        "dev": "nodemon --exec \"node --env-file=.env index.js\"",
        "dev:local": "nodemon index.local.js"
    },
    "nodemonConfig": {
        "watch": ["."],
        "ext": "js,json",
        "ignore": ["node_modules/", "db.json"]
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.4",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    }
}
